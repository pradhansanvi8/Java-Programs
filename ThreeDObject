abstract class T{
    abstract void s();
    abstract void v();
}

class B extends T{
    float l,b,h;
    B(float x,float y,float z){l=x;b=y;h=z;}
    void s(){System.out.println(2*(l*b+b*h+h*l));}
    void v(){System.out.println(l*b*h);}
}

class C extends T{
    float a;
    C(float x){a=x;}
    void s(){System.out.println(6*a*a);}
    void v(){System.out.println(a*a*a);}
}

class Y extends T{
    float r,h;
    Y(float x,float y){r=x;h=y;}
    void s(){System.out.println(2*Math.PI*r*(r+h));}
    void v(){System.out.println(Math.PI*r*r*h);}
}

class N extends T{
    float r,h;
    N(float x,float y){r=x;h=y;}
    void s(){System.out.println(Math.PI*r*(r+Math.sqrt(r*r+h*h)));}
    void v(){System.out.println(Math.PI*r*r*h/3);}
}

public class Main{
    public static void main(String[] a){
        T o;
        o=new B(2,3,4); o.s(); o.v();
        o=new C(3);     o.s(); o.v();
        o=new Y(2,5);   o.s(); o.v();
        o=new N(2,5);   o.s(); o.v();
    }
}